{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quka",
  "version": "1.1.3",
  "identifier": "com.quka.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quka",
        "width": 640,
        "height": 420,
        "minWidth": 520,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/icons/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwMUQwMjI0RUYwQ0RBRjcKUldUMzJnenZKQUlkZ0NTc2dyMnFBS3hWK0NBU1BzK0VuSVhmVW1Uc2tSelMvNllLVzQ2eEU1Z2kK",
      "endpoints": [
        "https://github.com/tomiaa12/Quka/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi", "dmg"],
    "publisher": "Quka",
    "copyright": "Copyright © 2026 Quka",
    "category": "Utility",
    "shortDescription": "极简跨平台应用启动器",
    "longDescription": "Quka 在后台运行，双击 Ctrl 或 Command 即可搜索并启动本机已安装的应用。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/nsis-hooks.nsh"
      },
      "wix": {
        "language": ["zh-CN", "en-US"],
        "upgradeCode": "9e2c1a70-4d8f-5b31-8c6a-1f0e7d5b2a44"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": false,
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}
